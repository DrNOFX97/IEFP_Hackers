rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Notes: each user can only read/write their own documents
    // Document ID format: {uid}_{ucCode}
    match /notes/{docId} {
      allow read, write: if request.auth != null
                         && docId.matches(request.auth.uid + '_.*');
    }

    // Materials: any authenticated user can read and write (shared per UC)
    match /materials/{ucCode} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Global chat: any authenticated user can read/create
    // Only the author (or a formador listed in /config/formadores) can soft-delete
    match /chat_global/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.deleted == false;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
                    && (resource.data.uid == request.auth.uid || isFormador());
      allow delete: if false;
    }

    // UC chat: same rules, per-UC subcollection
    match /uc_chats/{ucCode}/messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.deleted == false;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
                    && (resource.data.uid == request.auth.uid || isFormador());
      allow delete: if false;
    }

    // User presence: any auth user can read; only the owner can write their own doc
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Formadores config: readable by all authenticated users
    match /config/formadores {
      allow read: if request.auth != null;
      allow write: if false;  // managed manually in Firebase Console
    }

    function isFormador() {
      return exists(/databases/$(database)/documents/config/formadores)
          && request.auth.uid in get(/databases/$(database)/documents/config/formadores).data.uids;
    }
  }
}
