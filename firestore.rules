rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // Default: 'blocked' — utilizador sem doc ou sem role não tem acesso.
    // O role só é atribuído pelo servidor (Cloud Function redeemInvite) ou por admin.
    function getRole() {
      let uid = request.auth.uid;
      return isAuth() && exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'blocked')
        : 'blocked';
    }

    function isBlocked()    { return !isAuth() || getRole() == 'blocked'; }
    function isAdmin()      { return isAuth() && getRole() == 'admin'; }
    function isModerador()  { return isAuth() && getRole() in ['moderador', 'admin']; }
    function isAluno()      { return isAuth() && getRole() in ['aluno', 'moderador', 'admin']; }

    // ── users ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();

      // Criação: qualquer autenticado pode criar o seu doc,
      // mas NÃO pode definir role (o role é always 'blocked' por omissão;
      // só a Cloud Function Admin SDK pode definir role: 'aluno').
      allow create: if isAuth()
                    && request.auth.uid == uid
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == 'blocked');

      // Atualização: dono pode atualizar campos mas NÃO pode alterar role.
      // Admin pode alterar tudo.
      allow update: if (isAuth() && !isBlocked() && request.auth.uid == uid
                       && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // ── invites ───────────────────────────────────────────────────────
    // Leitura: qualquer autenticado (para validar token após login).
    // Escrita: só admin/mod pode criar/gerir convites.
    // O Cloud Function (Admin SDK) faz updates atómicos sem passar pelas rules.
    match /invites/{token} {
      allow read:   if isAuth();
      allow create: if isModerador()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.active    == true
                    && request.resource.data.uses      == 0;
      // Só permite revogar (alterar apenas campo 'active')
      allow update: if isModerador()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if isModerador();
    }

    // ── notes ─────────────────────────────────────────────────────────
    // Chave: {uid}_{sessionKey} — notas pessoais por utilizador.
    // sessionKey = ucCode (S1) ou ucCode_date (S2+).
    match /notes/{docId} {
      allow read: if isAuth() && (
        docId.matches(request.auth.uid + '_.*') || isModerador()
      );
      allow write: if isAuth() && !isBlocked() && docId.matches(request.auth.uid + '_.*');
      allow delete: if isAdmin();
    }

    // ── materials ─────────────────────────────────────────────────────
    // Chave: sessionKey (ucCode ou ucCode_date) — materiais partilhados por sessão.
    // Documento: { items: [{id, type, label, url, size, uid, createdAt}] }
    match /materials/{key} {
      allow read:  if isAluno();
      allow write: if isAluno();
    }

    // ── chat global ───────────────────────────────────────────────────
    match /chat_global/{msgId} {
      allow read: if isAluno();
      allow create: if isAluno()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.deleted == false;
      allow update: if isAuth()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
                    && (resource.data.uid == request.auth.uid || isModerador());
      allow delete: if isAdmin();
    }

    // ── uc chats ──────────────────────────────────────────────────────
    match /uc_chats/{ucCode}/messages/{msgId} {
      allow read: if isAluno();
      allow create: if isAluno()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.deleted == false;
      allow update: if isAuth()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
                    && (resource.data.uid == request.auth.uid || isModerador());
      allow delete: if isAdmin();
    }

    // ── audit_log ─────────────────────────────────────────────────────
    match /audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid', 'action', 'timestamp']);
      allow update, delete: if false;
    }

    // ── config ────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }
    
    // ── csp_violations ────────────────────────────────────────────────
    match /csp_violations/{docId} {
      allow read: if isAdmin();
      // Write is done via Cloud Function, no direct client write allowed for security
      allow write: if false; 
    }
  }
}
