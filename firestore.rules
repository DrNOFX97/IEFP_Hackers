rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // Lê o role do user do seu próprio documento.
    // Se o doc não existir ainda (primeiro login), devolve 'aluno' (mínimo privilégio).
    function getRole() {
      let uid = request.auth.uid;
      return isAuth() && exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'aluno')
        : 'aluno';
    }

    function isBlocked()  { return isAuth() && getRole() == 'blocked'; }
    function isAdmin()    { return isAuth() && !isBlocked() && getRole() == 'admin'; }
    function isModerador() { return isAuth() && !isBlocked() && getRole() in ['moderador', 'admin']; }
    function isAluno()    { return isAuth() && !isBlocked() && getRole() in ['aluno', 'moderador', 'admin']; }

    // ── users ─────────────────────────────────────────────────────────
    // Qualquer utilizador autenticado pode ler (colega de turma).
    // O dono pode escrever o seu próprio doc MAS NÃO pode alterar o campo 'role'.
    // Admin tem controlo total — incluindo alterar roles.
    match /users/{uid} {
      allow read: if isAuth();

      // Criação: dono só pode criar sem campo 'role'; utilizadores bloqueados não podem criar
      allow create: if isAuth() && !isBlocked() && request.auth.uid == uid
                    && !('role' in request.resource.data);

      // Atualização: dono pode atualizar tudo exceto 'role'; utilizadores bloqueados não podem; admin pode tudo
      allow update: if (isAuth() && !isBlocked() && request.auth.uid == uid
                       && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // ── notes ─────────────────────────────────────────────────────────
    // Formato doc ID: {uid}_{ucCode}
    // Aluno vê e edita as suas; formador/admin vê todas.
    match /notes/{docId} {
      allow read: if isAuth() && (
        docId.matches(request.auth.uid + '_.*') || isModerador()
      );
      allow write: if isAuth() && docId.matches(request.auth.uid + '_.*');
      allow delete: if isAdmin();
    }

    // ── materials ─────────────────────────────────────────────────────
    match /materials/{ucCode} {
      allow read:   if isAluno();
      allow write:  if isAluno();    // partilhado por toda a turma
    }

    // ── chat global ───────────────────────────────────────────────────
    match /chat_global/{msgId} {
      allow read: if isAluno();
      allow create: if isAluno()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.deleted == false;
      allow update: if isAuth()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
                    && (resource.data.uid == request.auth.uid || isModerador());
      allow delete: if isAdmin();
    }

    // ── uc chats ──────────────────────────────────────────────────────
    match /uc_chats/{ucCode}/messages/{msgId} {
      allow read: if isAluno();
      allow create: if isAluno()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.deleted == false;
      allow update: if isAuth()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
                    && (resource.data.uid == request.auth.uid || isModerador());
      allow delete: if isAdmin();
    }

    // ── audit_log ─────────────────────────────────────────────────────
    // Apenas admin pode ler.
    // Qualquer utilizador autenticado pode criar (uid deve coincidir).
    // Imutável: sem update nem delete.
    match /audit_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid', 'action', 'timestamp']);
      allow update, delete: if false;
    }

    // ── config ────────────────────────────────────────────────────────
    // Todos os autenticados podem ler; só admin pode escrever.
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
